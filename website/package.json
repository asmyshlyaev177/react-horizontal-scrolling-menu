{
  "name": "react-horizontal-scrolling-menu-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "description": "Landing page for react-horizontal-scrolling-menu, server-rendered on Cloudflare Workers",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test:tokens": "check-tokens src/styles/app.css",
    "test": "pnpm run test:tokens && pnpm run build && playwright test",
    "cf-typegen": "wrangler types",
    "test:a11y": "pnpm run build && playwright test -c playwright.a11y.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@formkit/auto-animate": "^0.10.0",
    "@tanstack/react-router": "^1.170.22",
    "@tanstack/react-start": "^1.168.39",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-horizontal-scrolling-menu": "workspace:*"
  },
  "devDependencies": {
    "@asmyshlyaev177/design-tokens": "^1.2.0",
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.51.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.1.2",
    "shiki": "^3.13.0",
    "tailwindcss": "^4.3.3",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "wrangler": "^4.120.0"
  },
  "allowScripts": {
    "workerd@1.20260801.1": true,
    "esbuild@0.28.1": true
  }
}
