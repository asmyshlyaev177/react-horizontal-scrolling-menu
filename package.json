{
  "name": "react-horizontal-scrolling-menu",
  "version": "8.3.2",
  "author": {
    "name": "Aleksandr Smyshliaev",
    "email": "asmyshlyaev177@gmail.com",
    "url": "https://asmyshlyaev177.dev"
  },
  "description": "Horizontal scrolling menu component for React with per-item visibility tracking. Supports mouse and touch devices, SSR-safe.",
  "keywords": [
    "front-end",
    "react",
    "react-component",
    "menu",
    "navigation",
    "gallery",
    "horizontal",
    "horizontal-scroll",
    "scroll",
    "scrolling",
    "scrolling-menu",
    "carousel",
    "slider",
    "swipe",
    "tabs",
    "intersection-observer",
    "typescript",
    "tanstack-intent"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.0.9",
  "type": "module",
  "main": "dist/index.mjs",
  "browser": "dist/index.mjs",
  "module": "dist/index.mjs",
  "unpkg": "dist/index.cjs",
  "types": "dist/types/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asmyshlyaev177/react-horizontal-scrolling-menu.git"
  },
  "homepage": "https://react-horizontal-scrolling-menu.dev",
  "funding": {
    "type": "patreon",
    "url": "https://patreon.com/asmyshlyaev177"
  },
  "bugs": {
    "url": "https://github.com/asmyshlyaev177/react-horizontal-scrolling-menu/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "browser": "./dist/index.mjs",
      "module": "./dist/index.mjs",
      "import": "./dist/index.mjs",
      "umd": "./dist/index.cjs",
      "require": "./dist/index.cjs"
    },
    "./dist/styles.css": "./dist/styles.css",
    "./styles.css": "./dist/styles.css"
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/types/"
      ]
    }
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "warn"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{html,css,less,ejs,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "i18n": "node scripts/i18n/cli.mjs",
    "i18n:init": "node scripts/i18n/cli.mjs init",
    "i18n:check": "node scripts/i18n/cli.mjs check",
    "i18n:copy": "node scripts/i18n/copy.mjs",
    "i18n:copy:init": "node scripts/i18n/copy.mjs init",
    "i18n:copy:check": "node scripts/i18n/copy.mjs check",
    "test:unit": "wireit",
    "test:e2e": "wireit",
    "test:e2e:dev": "wireit",
    "test:storybook": "wireit",
    "test:storybook-ci": "wireit",
    "pretest": "pnpm run prune-cache",
    "test": "wireit",
    "test:lint": "wireit",
    "run:e2e": "wireit",
    "predev": "pnpm run prune-cache",
    "dev": "wireit",
    "kill-rollup": "wireit",
    "prebuild": "pnpm run prune-cache",
    "build": "wireit",
    "demo": "wireit",
    "serve": "wireit",
    "release": "wireit",
    "pub": "wireit",
    "push": "wireit",
    "beta": "pnpm version premajor --preid=beta",
    "beta:bump": "pnpm version prerelease",
    "beta:pub": "pnpm run build && npm publish --tag beta",
    "reinstall": "pnpm run cleanup && pnpm run setup",
    "setup-tooling": "wireit",
    "setup": "pnpm install && pnpm run setup-tooling",
    "cleanup": "rm -rf node_modules example-nextjs/node_modules example-tanstack/node_modules .wireit dist",
    "storybook": "wireit",
    "storybook:static": "wireit",
    "build-storybook": "wireit",
    "prepack": "pnpm run build",
    "prepare": "husky",
    "release:preflight": "wireit",
    "deploy": "wireit",
    "preview": "wireit",
    "serve-tanstack": "wireit",
    "demo-tanstack": "wireit",
    "prune-cache": "node scripts/prune-wireit-cache.mjs"
  },
  "wireit": {
    "build-storybook": {
      "command": "storybook build",
      "dependencies": [
        "build",
        "setup-tooling"
      ]
    },
    "storybook": {
      "command": "storybook dev -p 6006 --no-open",
      "service": {
        "readyWhen": {
          "lineMatches": "localhost:6006"
        }
      },
      "dependencies": [
        "build",
        "setup-tooling"
      ]
    },
    "storybook:static": {
      "command": "http-server storybook-static -p 6007 -c-1 -s",
      "service": true,
      "dependencies": [
        "build-storybook",
        "setup-tooling"
      ]
    },
    "test:storybook-ci": {
      "command": "npx wait-on -l -t 120000 --httpTimeout 10000 http://127.0.0.1:6007 && test-storybook --browsers firefox chromium webkit --url http://127.0.0.1:6007",
      "dependencies": [
        "storybook:static",
        "setup-tooling"
      ]
    },
    "test:storybook": {
      "command": "npx wait-on -l -t 120000 --httpTimeout 10000 http://127.0.0.1:6007 && test-storybook --browsers firefox chromium --url http://127.0.0.1:6007",
      "dependencies": [
        "storybook:static",
        "setup-tooling"
      ]
    },
    "release:preflight": {
      "command": "sh -eu -c 'branch=$(git rev-parse --abbrev-ref HEAD); [ \"$branch\" = master ] || { echo \"Refusing to release from $branch; releases are cut from master.\" >&2; exit 1; }; [ -z \"$(git status --porcelain)\" ] || { echo \"Refusing to release with a dirty working tree; commit or stash first.\" >&2; git status --short >&2; exit 1; }; git fetch --quiet origin master; [ \"$(git rev-parse HEAD)\" = \"$(git rev-parse origin/master)\" ] || { echo \"Local master is not in sync with origin/master; pull or push first.\" >&2; exit 1; }'"
    },
    "release": {
      "command": "commit-and-tag-version --no-verify",
      "dependencies": [
        "release:preflight",
        "test:lint",
        "test"
      ]
    },
    "pub": {
      "command": "pnpm run release && pnpm run push && npm publish",
      "dependencies": [
        "build"
      ]
    },
    "push": {
      "command": "git push --follow-tags origin HEAD"
    },
    "test": {
      "command": "pnpm run test:e2e && pnpm run test:e2e:dev",
      "dependencies": [
        "test:unit",
        "test:storybook"
      ]
    },
    "test:lint": {
      "command": "eslint src e2e playwright.config.ts website/src && prettier --check src e2e playwright.config.ts website/src && tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
      "dependencies": [
        "setup-tooling"
      ]
    },
    "test:unit": {
      "command": "jest",
      "dependencies": [
        "setup-tooling"
      ]
    },
    "test:e2e": {
      "command": "pnpm run run:e2e",
      "dependencies": [
        "serve",
        "serve-tanstack"
      ]
    },
    "test:e2e:dev": {
      "command": "pnpm run run:e2e",
      "dependencies": [
        "demo",
        "demo-tanstack"
      ]
    },
    "kill-rollup": {
      "command": "ps aux | grep rollup | grep -v grep | awk '{print $2}' | xargs kill -9 || echo 'killed'"
    },
    "run:e2e": {
      "command": "npx wait-on -l -t 300000 --httpTimeout 10000 http://localhost:3003 http://localhost:3004 && playwright test",
      "dependencies": [
        "install:playwright"
      ]
    },
    "dev": {
      "command": "cross-env IS_DEVELOPMENT=true rollup -c rollup.config.js -w",
      "service": true,
      "dependencies": [
        "setup-tooling",
        "kill-rollup"
      ]
    },
    "demo": {
      "command": "cd example-nextjs && pnpm run dev",
      "service": true,
      "dependencies": [
        "dev"
      ]
    },
    "serve": {
      "command": "cd example-nextjs && pnpm run build && pnpm run serve 1> /dev/null",
      "service": true,
      "dependencies": [
        "build"
      ]
    },
    "install:playwright": {
      "command": "npx playwright install chromium firefox webkit",
      "clean": false,
      "files": [
        "package.json"
      ],
      "output": []
    },
    "setup-tooling": {
      "command": "echo 'setup'",
      "files": [
        "package.json"
      ],
      "clean": false,
      "output": [],
      "dependencies": [
        "install:playwright"
      ]
    },
    "build": {
      "command": "rollup -c rollup.config.js",
      "clean": true,
      "output": [
        "dist",
        "dist/index.cjs",
        "dist/index.mjs",
        "dist/types"
      ],
      "dependencies": [
        "setup-tooling",
        "kill-rollup"
      ]
    },
    "serve-tanstack": {
      "command": "cd example-tanstack && pnpm run build && pnpm run serve",
      "service": true,
      "dependencies": [
        "build"
      ]
    },
    "demo-tanstack": {
      "command": "cd example-tanstack && pnpm run dev",
      "service": true,
      "dependencies": [
        "dev"
      ]
    },
    "deploy": {
      "command": "cd website && pnpm run deploy",
      "dependencies": [
        "build"
      ]
    },
    "preview": {
      "command": "cd website && pnpm run preview",
      "dependencies": [
        "build"
      ]
    }
  },
  "browserslist": [
    "last 5 Chrome versions",
    "last 5 ChromeAndroid versions",
    "last 5 Firefox versions",
    "last 5 FirefoxAndroid versions",
    "Firefox ESR",
    "last 3 Safari major versions",
    "last 2 iOS major versions"
  ],
  "peerDependencies": {
    "react": ">=16.8",
    "react-dom": ">=16.8"
  },
  "files": [
    "dist",
    "skills",
    "!skills/_artifacts"
  ],
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^9.39.5",
    "@formkit/auto-animate": "^0.8.4",
    "@jest/globals": "^30.4.1",
    "@playwright/test": "^1.62.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
